# Copy to .env with mode 0600 and replace registry.example.invalid values.
# Do not commit the resulting .env file or place credentials in image URLs.
NEXORA_API_IMAGE=registry.example.invalid/torogoz-tech/nexora-api:0.4.0
NEXORA_WEB_IMAGE=registry.example.invalid/torogoz-tech/nexora-web:0.4.0
NEXORA_MCP_IMAGE=registry.example.invalid/torogoz-tech/nexora-mcp:0.4.0
NEXORA_ANALYSIS_IMAGE=registry.example.invalid/torogoz-tech/nexora-analysis-worker:0.4.0
NEXORA_RELEASE_IMAGE=registry.example.invalid/torogoz-tech/nexora-release-worker:0.4.0
NEXORA_KNOWLEDGE_IMAGE=registry.example.invalid/torogoz-tech/nexora-knowledge-worker:0.4.0
NEXORA_NOTIFICATION_IMAGE=registry.example.invalid/torogoz-tech/nexora-notification-worker:0.4.0

# Keep the existing compatibility worker image during a staged cutover.
# Pin this to the installed image digest, then retire the service after the
# replacement workers have completed a verified job lifecycle.
NEXORA_LEGACY_API_IMAGE=registry.example.invalid/torogoz-tech/nexora-api:legacy-worker

# Replace these examples with matching credentials and URL-encode URI values.
NEXORA_RABBITMQ_URL=amqp://nexora:REPLACE_ME@127.0.0.1:5672/nexora
RABBITMQ_DEFAULT_USER=nexora
RABBITMQ_DEFAULT_PASS=REPLACE_ME
RABBITMQ_DEFAULT_VHOST=nexora

# Replace with the numeric UID/GID of the existing Nexora runtime account.
NEXORA_UID=999
NEXORA_GID=987
